# RakshakAI Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application environment: development | production
APP_ENV=development

# JWT secret - must be at least 32 random characters in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-strong-random-secret-before-deploying

# Database URL
# SQLite (default for local dev - no setup needed):
DATABASE_URL=sqlite:///./rakshakai.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rakshakai

# Allowed CORS origins (comma-separated, no trailing slash)
# Development default is http://localhost:3000 - set this for production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Gemini AI (optional) ---
# Leave blank to disable the AI assistant; the API returns a safe fallback.
GEMINI_API_KEY=
# Model name - defaults to gemini-3.8-flash if unset
GEMINI_MODEL=gemini-3.8-flash

# --- OCR (optional) ---
# Set to "tesseract" to enable local OCR for screenshots and scanned PDFs.
# Requires tesseract-ocr to be installed on the host.
OCR_PROVIDER=tesseract
# Tesseract language packs (+ separated)
TESSERACT_LANG=eng+hin+kan
# Override tesseract binary path if not on system PATH
# TESSERACT_CMD=/usr/bin/tesseract

# --- PostgreSQL (only used with compose.yaml) ---
POSTGRES_DB=rakshakai
POSTGRES_USER=rakshakai
POSTGRES_PASSWORD=change-this-password-before-sharing
POSTGRES_PORT=5432