# RakshakAI Frontend - Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# Backend API base URL (no trailing slash, no /api suffix)
# Development default (if unset): http://localhost:8000
# Set this to your deployed backend URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Override the Next.js build output directory
# NEXT_DIST_DIR=.next